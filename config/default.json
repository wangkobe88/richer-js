    "tickBuffer": {
      "flushIntervalMs": 2000,
      "flushThreshold": 100,
      "batchSize": 500
    },
    "wssDownGuardMs": 900000,
    "bnbUsd": {
      "refreshMs": 60000
    },
    "maxTrackedTokens": 300,
    "signalDebounceMs": 1500,
    "signalDebounceMaxWaitMs": 5000,
    "pruneIntervalMs": 300000,
    "pruneMaxAgeMs": 1800000,
    "timeSeriesIntervalMs": 30000,
    "timeSeriesActiveWindowMs": 60000,
    "minTickBnb": 0.001,
    "live": {
      "reserveNative": 0.01,
      "slippageTolerance": 5,
      "maxGasPrice": 10,
      "holdingsSyncMs": 300000,
      "sellFailureCooldownMs": 60000
    }
  },
  "strategy": {
    "buyTimeMinutes": 1.33,
    "earlyReturnMin": 80,
    "earlyReturnMax": 120,
    "takeProfit1": 30,
    "takeProfit1Sell": 0.5,
    "takeProfit2": 50,
    "takeProfit2Sell": 1.0,
    "stopLossMinutes": 5
  },
  "narrative": {
    "enableImageAnalysis": true,
    "enableVideoAnalysis": false,
    "twitterBlacklist": [
      "Cortaviousloma1",
      "goxpv32196782",
      "heyi1f",
      "IsuzkaAruna",
      "CDaneliak56999",
      "trenchsiu"
    ],
    "expiredTweetDaysThreshold": 14,
    "sameNameCheck": {
      "enabled": true,
      "rules": {
        "priceChangeThreshold": 300,
        "txVolumeThreshold": 30000,
        "txCountThreshold": 300
      }
    }
  },
  "preBuyCheck": {
    "holderCheckEnabled": true,
    "earlyParticipantFilterEnabled": true,
    "earlyParticipantStrategy": "three_feature_and_p25",
    "threeFeatureAndP25": {
      "volumePerMinThreshold": 1610,
      "countPerMinThreshold": 14,
      "highValuePerMinThreshold": 8
    },
    "largeHoldingThreshold": 18,
    "clusterBlockThreshold": 7,
    "earlyTradesLookbackSeconds": 90

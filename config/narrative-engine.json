{
  "engine": {
    "maxConcurrency": 30,
    "pollingInterval": 3000,
    "taskTimeout": 180000,
    "maxRetries": 3,
    "precheckFailRetry": {
      "enabled": true,
      "scanIntervalMs": 30000,
      "retryWindowSec": 300,
      "noPublicInfoRetryWindowSec": 1800,
      "tradeSurgeThreshold": 20,
      "maxRetriesPerToken": 5,
      "maxPerScan": 2
    }
  },
  "jev": {
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-latest",
    "apiKeyEnv": "TYPESAFE_API_KEY",
    "timeoutMs": 30000,
    "retryCount": 2
  },
  "vision": {
    "enabled": true,
    "baseUrl": "https://api.siliconflow.cn/v1",
    "model": "Qwen/Qwen3-Omni-30B-A3B-Captioner",
    "apiKeyEnv": "SILICONFLOW_FALLBACK_KEY",
    "timeoutMs": 30000,
    "maxTokens": 1500,
    "retryCount": 2,
    "cacheTtlSec": 7776000
  }
}

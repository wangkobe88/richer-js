{
  "engine": {
    "maxConcurrency": 30,
    "pollingInterval": 3000,
    "taskTimeout": 180000,
    "maxRetries": 3,
    "precheckFailRetry": {
      "enabled": true,
      "scanIntervalMs": 30000,
      "retryWindowSec": 300,
      "noPublicInfoRetryWindowSec": 1800,
      "tradeSurgeThreshold": 20,
      "maxRetriesPerToken": 5,
      "maxPerScan": 2
    }
  },
  "jev": {
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-latest",
    "apiKeyEnv": "TYPESAFE_API_KEY",
    "timeoutMs": 30000,
    "retryCount": 2
  },
  "vision": {
    "enabled": true,
    "baseUrl": "https://api.siliconflow.cn/v1",
    "model": "Qwen/Qwen3-Omni-30B-A3B-Captioner",
    "apiKeyEnv": "SILICONFLOW_FALLBACK_KEY",
    "timeoutMs": 30000,
    "maxTokens": 2500,
    "retryCount": 2,
    "cacheTtlSec": 63072000,
    "gate": {
      "enabled": true,
      "minSufficientProb": 0.6
    }
  },
  "websiteFetch": {
    "enabled": false
  },
  "corpusGate": {
    "enabled": true,
    "minSufficientProb": 0.6
  },
  "searchFallback": {
    "enabled": false,
    "corpusMode": "empty",
    "minNameChars": 4,
    "sinceDays": 7,
    "products": ["Top", "Latest"],
    "count": 20,
    "stateTopTweets": 5,
    "stateMaxChars": 2500,
    "bypass": {
      "minTweets": 3,
      "minTopEngagement": 200
    },
    "timeoutMs": 5000,
    "cacheTtlSec": 1800
  }
}

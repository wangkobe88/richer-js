{
  "engine": {
    "maxConcurrency": 30,
    "pollingInterval": 3000,
    "taskTimeout": 180000,
    "maxRetries": 3,
    "precheckFailRetry": {
      "enabled": true,
      "scanIntervalMs": 30000,
      "retryWindowSec": 300,
      "tradeSurgeThreshold": 20,
      "maxRetriesPerToken": 5,
      "maxPerScan": 2
    }
  },
  "jev": {
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-latest",
    "apiKeyEnv": "TYPESAFE_API_KEY",
    "timeoutMs": 30000,
    "retryCount": 2
  }
}

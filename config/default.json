{
  "ave": {
    "apiUrl": "https://prod.ave-api.com",
    "timeout": 30000
  },
  "fourmeme": {
    "apiUrl": "https://four.meme",
    "timeout": 30000
  },
  "fourmemeWs": {
    "endpointFrom": "env",
    "contracts": {
      "tokenManagerV2": "0x5c952063c7fc8610FFDB798152D69F0B9550762b",
      "tokenManagerV1": "0xEC4549caDcE5DA21Df6E6422d448034B5233bFbC"
    },
    "subscribeV1": false,
    "pingIntervalMs": 10000,
    "reconnect": {
      "minDelayMs": 2000,
